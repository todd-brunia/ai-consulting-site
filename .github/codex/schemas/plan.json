{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "markdown", "blockingDecision", "splitReason", "children"],
  "properties": {
    "classification": {
      "type": "string",
      "enum": ["focused", "needs-decision", "split-required"]
    },
    "markdown": {
      "type": "string",
      "minLength": 40,
      "maxLength": 12000
    },
    "blockingDecision": {
      "type": ["string", "null"],
      "minLength": 10,
      "maxLength": 2000
    },
    "splitReason": {
      "type": ["string", "null"],
      "minLength": 10,
      "maxLength": 2000
    },
    "children": {
      "type": ["array", "null"],
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "outcome",
          "acceptanceCriteria",
          "dependencies",
          "includedScope",
          "excludedScope",
          "suggestedLabels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 64
          },
          "title": { "type": "string", "minLength": 5, "maxLength": 160 },
          "outcome": { "type": "string", "minLength": 10, "maxLength": 2000 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 3, "maxLength": 500 }
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "includedScope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 3, "maxLength": 500 }
          },
          "excludedScope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 3, "maxLength": 500 }
          },
          "suggestedLabels": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        }
      }
    }
  }
}
